HTTP_ADDR=:8080
PUBLIC_BASE_URL=
DOMAIN=
LOG_LEVEL=info
DEFAULT_TIMEZONE=America/Toronto
ALLOWED_SENDERS=
# The rest of this block, DEFAULT_TIMEZONE, LOG_LEVEL, OPENAI_MODEL, and its
# prices are defaults: they can all be changed later by text
# Lowest daily calorie goal Fitbot accepts
CALORIE_FLOOR=1200
# How far from the goal, in percent, calories, carbs, and fat count as on goal
GOAL_BAND=10
# How long after the gym reminder "Did you make it to the gym?" goes (15m to 6h)
GYM_FOLLOWUP_DELAY=2h
# Send a supplement reminder again this long after, if not logged (0 for never, or 15m to 6h)
SUPPLEMENT_REPING=0
# Most water nudges a day when behind pace (0 to 4)
WATER_NUDGES=1

POSTGRES_USER=fitbot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fitbot
DB_PORT=5432
DATABASE_URL=postgres://fitbot:change-me@localhost:5432/fitbot?sslmode=disable

TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_FROM_NUMBER=

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
# USD per 1M tokens for OPENAI_MODEL; leave empty to skip cost tracking
OPENAI_INPUT_PRICE=
OPENAI_OUTPUT_PRICE=
